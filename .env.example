DATABASE_URL="postgresql://mlm:mlm@localhost:5432/mlm?schema=public"
APP_URL="http://localhost:3000"
PAYMENT_PROVIDER="test"
TEST_PAYMENT_SECRET="dev-only-test-payment-secret"
CRON_SECRET="dev-only-cron-secret"
# Paystack: set PAYMENT_PROVIDER="paystack" and a TEST secret key from your Paystack dashboard.
# Never commit real keys. Live keys (sk_live_) belong only in the production host's secret store.
PAYSTACK_SECRET_KEY=""
APP_ENCRYPTION_KEY="" # 32 random bytes, base64: openssl rand -base64 32

# Production also needs (see docs/DEPLOYMENT.md):
# NODE_ENV="production"
# STORAGE_DRIVER="s3"  S3_BUCKET  S3_REGION  S3_ENDPOINT  S3_ACCESS_KEY_ID  S3_SECRET_ACCESS_KEY  S3_PUBLIC_URL
# PAYOUT_VERIFICATION="paystack"   # or "manual"
# EMAIL_PROVIDER                   # an email provider must be connected before launch
# MONITOR_TOKEN                    # for /api/health/status (docs/MONITORING.md)
# TRUSTED_PROXY_HOPS="1"           # proxies in front of the app that add X-Forwarded-For
# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD   # first deploy only, then remove
# SEED_SAMPLE_PRODUCTS=1   # staging only: sample products in a production build (never in production)
