generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  AFFILIATE
  ADMIN
  SUPER_ADMIN
}

/// Areas an ADMIN can be granted. SUPER_ADMIN has all of them.
enum AdminPermission {
  ORDERS
  PRODUCTS
  MEMBERS
  NETWORK
  COMMISSIONS
  PAYOUTS
  SUPPORT
  RISK
  SETTINGS
  AUDIT
  /// See and edit product cost prices and margins.
  PRODUCT_COSTS
  /// See members' full bank account numbers and export payout batches.
  PAYOUT_DETAILS
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Leg {
  LEFT
  RIGHT
}

/// Order lifecycle. Allowed moves are defined in src/lib/order-state.ts.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  /// Sent to the gateway, waiting for confirmation.
  PENDING
  PROCESSED
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InventoryReason {
  /// New stock received from a supplier.
  RESTOCK
  /// Reserved by a new order (before payment).
  SALE
  /// Unpaid order cancelled or expired: reservation returned.
  RELEASE
  /// Refund of an order that never shipped: goods never left, so they go back to stock.
  REFUND
  /// Returned goods inspected and fit to resell.
  RETURN_RESTOCK
  /// Returned goods not fit to resell. Recorded with delta 0 for the audit trail.
  RETURN_WRITE_OFF
  /// Manual correction: stock count, damage, loss.
  ADJUSTMENT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CommissionType {
  DIRECT
  BINARY
  ADJUSTMENT
}

enum CommissionStatus {
  /// Earned on a paid order, waiting for the refund window to close.
  PENDING
  /// Frozen by a dispute or by an administrator.
  HELD
  /// Counts toward the withdrawable balance.
  APPROVED
  REVERSED
  /// Fully covered by a completed payout.
  PAID
}

enum PayoutAccountStatus {
  ACTIVE
  REMOVED
}

enum PayoutBatchStatus {
  /// Payouts are in the batch and being sent.
  OPEN
  /// The transfer file has been downloaded for the bank.
  EXPORTED
  /// Every payout in it is paid or failed.
  CLOSED
}

/// REQUESTED (funds reserved) → APPROVED (reviewed) → PROCESSING (sent to the bank or provider) → PAID,
/// or REJECTED / FAILED, which release the reserved funds back to the wallet.
enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

enum LedgerType {
  COMMISSION_EARNED
  COMMISSION_APPROVED
  COMMISSION_HELD
  COMMISSION_RELEASED
  COMMISSION_REVERSED
  WITHDRAWAL_RESERVED
  WITHDRAWAL_PAID
  WITHDRAWAL_RELEASED
  ADMIN_CORRECTION
}

/// Where a member's money sits. See src/lib/ledger.ts for the sign convention.
enum LedgerBucket {
  PENDING
  HELD
  AVAILABLE
  RESERVED
  PAID_OUT
  REVERSED
}

model User {
  id                     String            @id @default(cuid())
  /// Always stored lower-cased and trimmed (enforced by a CHECK constraint).
  email                  String            @unique
  emailVerifiedAt        DateTime?
  passwordHash           String
  emailOrderUpdates      Boolean           @default(true)
  emailCommissionUpdates Boolean           @default(true)
  emailMarketing         Boolean           @default(false)
  name                   String
  phone                  String?
  role                   Role              @default(CUSTOMER)
  status                 UserStatus        @default(ACTIVE)
  referralCode           String            @unique
  /// Affiliate waiting for an administrator to choose their position (approval placement mode).
  placementPending       Boolean           @default(false)
  requestedLeg           Leg?
  signupIp               String?
  adminPermissions       AdminPermission[]
  /// TOTP secret, encrypted with APP_ENCRYPTION_KEY.
  mfaSecretEnc           String?
  mfaEnabledAt           DateTime?
  /// Last accepted TOTP time step, to stop a code being reused.
  mfaLastStep            Int?
  mfaRecoveryHashes      String[]
  sponsorId              String?
  sponsor                User?             @relation("Sponsorship", fields: [sponsorId], references: [id])
  referrals              User[]            @relation("Sponsorship")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  sessions       Session[]
  node           AffiliateNode?
  cartItems      CartItem[]
  orders         Order[]
  commissions    Commission[]
  payouts        Payout[]
  payoutAccounts PayoutAccount[]
  ledger         LedgerEntry[]
  addresses      Address[]
  notifications  Notification[]
  tickets        SupportTicket[]
  returns        ReturnRequest[]

  @@index([sponsorId])
  @@index([createdAt])
  @@index([role, status])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  /// True until the second factor is entered for an MFA-enabled account.
  mfaPending    Boolean   @default(false)
  lastSeenAt    DateTime  @default(now())
  mfaVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  ip            String?
  userAgent     String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// A position in the binary tree. One per affiliate.
model AffiliateNode {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  parentId        String?
  parent          AffiliateNode?   @relation("Tree", fields: [parentId], references: [id])
  children        AffiliateNode[]  @relation("Tree")
  position        Leg?
  depth           Int              @default(0)
  /// Ancestor node ids, root first. Used to credit volume up the tree in one query.
  ancestorIds     String[]
  /// Preferred leg for new referrals when the link doesn't specify one. Null = weaker leg.
  defaultLeg      Leg?
  placementRecord PlacementRecord?

  personalPv   Int @default(0)
  leftCarryPv  Int @default(0)
  rightCarryPv Int @default(0)
  leftTotalPv  Int @default(0)
  rightTotalPv Int @default(0)
  leftCount    Int @default(0)
  rightCount   Int @default(0)

  createdAt DateTime @default(now())

  volumes        VolumeEntry[]
  carryMovements CarryMovement[]

  @@unique([parentId, position])
  @@index([parentId])
  /// Descendant queries ("everyone under X") use `ancestorIds @> ARRAY[X]`, served by this GIN index.
  @@index([ancestorIds], type: Gin)
  @@index([depth])
}

/// Every PV credit to a node's leg, so volume can be audited and reversed.
model VolumeEntry {
  id        String        @id @default(cuid())
  nodeId    String
  node      AffiliateNode @relation(fields: [nodeId], references: [id])
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  leg       Leg?
  /// Positive on credit, negative on reversal. Null leg = personal volume.
  pv        Int
  createdAt DateTime      @default(now())

  @@index([nodeId])
  @@index([orderId])
}

/// Changes to leg carry that don't come from an order: PV consumed or flushed by a binary run,
/// or a reversal that was larger than the remaining carry. Carry = sum(VolumeEntry leg) + sum(CarryMovement).
model CarryMovement {
  id        String        @id @default(cuid())
  nodeId    String
  node      AffiliateNode @relation(fields: [nodeId], references: [id])
  leg       Leg
  pv        Int
  reason    CarryReason
  runId     String?
  run       BinaryRun?    @relation(fields: [runId], references: [id])
  orderId   String?
  createdAt DateTime      @default(now())

  @@index([nodeId])
  @@index([runId])
}

enum CarryReason {
  BINARY_RUN
  REVERSAL_FLOOR
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategories")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  sku         String        @unique
  slug        String        @unique
  name        String
  description String
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)

  /// Prices in kobo (minor units). Variants may override them.
  priceMinor     Int
  salePriceMinor Int?
  saleStartsAt   DateTime?
  saleEndsAt     DateTime?
  /// Restricted: only staff with PRODUCT_COSTS see this. Omitted from queries by default.
  costPriceMinor Int?
  /// Lowest current price across the product and its variants, kept up to date for sorting and filtering.
  /// Never used to charge anyone: checkout always recomputes from the product and variant records.
  listPriceMinor Int       @default(0)
  pv             Int       @default(0)

  /// Stock for products without variants. Products with variants keep stock on each variant.
  stock             Int       @default(0)
  lowStockThreshold Int       @default(5)
  lowStockAlertedAt DateTime?

  shippable      Boolean @default(true)
  /// VAT-exempt goods (for example some basic food and medical items).
  taxExempt      Boolean @default(false)
  /// Whether sales of this product earn direct commission (per the approved plan).
  commissionable Boolean @default(true)
  weightGrams    Int     @default(0)
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?

  metaTitle       String?
  metaDescription String?
  /// Free-form product facts shown on the product page, e.g. {"Brand": "...", "NAFDAC No.": "..."}.
  attributes      Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants   ProductVariant[]
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@index([status, listPriceMinor])
  @@index([categoryId])
}

model ProductVariant {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String    @unique
  /// e.g. "500 ml" or "Large / Blue"
  name              String
  /// e.g. {"Size": "Large", "Colour": "Blue"}
  options           Json      @default("{}")
  /// Overrides; null means use the product's value.
  priceMinor        Int?
  salePriceMinor    Int?
  costPriceMinor    Int?
  pv                Int?
  weightGrams       Int?
  stock             Int       @default(0)
  lowStockThreshold Int?
  lowStockAlertedAt DateTime?
  active            Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]
  images     ProductImage[]

  @@index([productId])
}

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Object storage key (server generated, never from the uploader's filename).
  storageKey String          @unique
  url        String
  alt        String          @default("")
  width      Int
  height     Int
  bytes      Int
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([productId, sortOrder])
}

model InventoryMovement {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  delta     Int
  /// Stock level right after this movement, for an easy-to-read history.
  balance   Int?
  reason    InventoryReason
  orderId   String?
  actorId   String?
  note      String?
  createdAt DateTime        @default(now())

  @@index([productId, createdAt])
}

model CartItem {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// variantId, or "" for products without variants. Lets the unique key below work with no variant.
  variantKey String          @default("")
  quantity   Int
  createdAt  DateTime        @default(now())

  @@unique([userId, productId, variantKey])
}

model Order {
  id            String           @id @default(cuid())
  number        String           @unique
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  status        OrderStatus      @default(PENDING_PAYMENT)
  currency      String
  /// Sum of item prices (after any sale price), before discount.
  subtotalMinor Int
  discountMinor Int              @default(0)
  discountCode  String?
  shippingMinor Int
  /// VAT. When taxIncluded, it is the VAT already inside the prices; otherwise it was added to the total.
  taxMinor      Int              @default(0)
  taxRateBps    Int              @default(0)
  taxIncluded   Boolean          @default(true)
  totalMinor    Int
  totalPv       Int
  /// Running totals of partial and full refunds.
  refundedMinor Int              @default(0)
  refundedPv    Int              @default(0)
  /// Compensation plan version in force when the order was paid. All of its commissions use these rules.
  planVersionId String?
  planVersion   CompPlanVersion? @relation(fields: [planVersionId], references: [id])
  /// "<userId>:<token>" from the checkout form, so a double-submitted checkout makes one order.
  checkoutKey   String?          @unique
  /// Node that receives this order's volume (buyer's node, or their sponsor's node for customers).
  volumeNodeId  String?
  /// Sponsor credited with the direct bonus, snapshotted at checkout.
  referrerId    String?

  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipCountry String
  shipPostal  String?
  carrier     String?
  trackingRef String?
  shippedAt   DateTime?
  deliveredAt DateTime?

  paidAt             DateTime?
  /// The payment that paid this order. Any other successful payment on it is an extra payment to give back.
  paidPaymentId      String?   @unique
  processingAt       DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  confirmationSentAt DateTime?
  /// Set while a chargeback is open; such orders don't earn commissions until it's resolved.
  disputedAt         DateTime?
  /// Set when the refund-hold window passes and commissions + volume are credited.
  commissionedAt     DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items       OrderItem[]
  payments    Payment[]
  volumes     VolumeEntry[]
  commissions Commission[]
  returns     ReturnRequest[]
  refunds     Refund[]
  redemption  DiscountRedemption?

  @@index([userId])
  @@index([referrerId])
  @@index([status, paidAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([commissionedAt, paidAt])
  @@index([volumeNodeId])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  name             String
  variantName      String?
  sku              String
  unitPriceMinor   Int
  /// The regular price at the time, when the item was bought on sale.
  listPriceMinor   Int?
  pv               Int
  quantity         Int
  /// This line's share of the order discount, and what the customer paid for it in total
  /// (after discount, plus VAT when VAT was added on top). Partial refunds are worked out from paidMinor.
  discountMinor    Int             @default(0)
  paidMinor        Int             @default(0)
  /// VAT inside this line, and the line's value excluding VAT after discount: the commissionable base.
  taxMinor         Int             @default(0)
  netMinor         Int             @default(0)
  commissionable   Boolean         @default(true)
  refundedQty      Int             @default(0)
  refundedMinor    Int             @default(0)
  refundedNetMinor Int             @default(0)
  /// Returned units put back into stock, and units written off, after a refund.
  restockedQty     Int             @default(0)
  writtenOffQty    Int             @default(0)
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id])
  provider         String
  providerRef      String        @unique
  status           PaymentStatus @default(PENDING)
  amountMinor      Int
  currency         String
  /// Gateway checkout page for this attempt, reused if the buyer clicks Pay again.
  authorizationUrl String?
  failureReason    String?
  verifiedAt       DateTime?
  refundedMinor    Int           @default(0)
  raw              Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id])
  paymentId        String?
  payment          Payment?     @relation(fields: [paymentId], references: [id])
  amountMinor      Int
  status           RefundStatus @default(PENDING)
  /// Gateway refund id, unique so a refund webhook can only be matched once.
  providerRefundId String?      @unique
  reason           String
  /// [{ orderItemId, quantity, amountMinor }] plus shippingMinor, for partial refunds.
  lines            Json         @default("[]")
  /// Where the refund came from: an admin, the gateway dashboard, or a chargeback.
  source           String       @default("admin")
  actorId          String?
  /// Why the gateway refused or couldn't confirm it. Shown on the order and risk pages so staff can retry.
  failureReason    String?
  attempts         Int          @default(0)
  createdAt        DateTime     @default(now())
  processedAt      DateTime?

  @@index([orderId])
  @@index([status])
  @@index([paymentId])
}

model DiscountCode {
  id               String       @id @default(cuid())
  /// Stored upper-case; customers can type any case.
  code             String       @unique
  description      String
  type             DiscountType
  /// PERCENT: basis points (1000 = 10%). FIXED: kobo.
  value            Int
  minSubtotalMinor Int          @default(0)
  /// Cap for percentage discounts, in kobo. Null = no cap.
  maxDiscountMinor Int?
  startsAt         DateTime?
  endsAt           DateTime?
  /// Null = unlimited.
  maxRedemptions   Int?
  perCustomerLimit Int          @default(1)
  /// Counts orders holding the code (released if the order is cancelled).
  redeemedCount    Int          @default(0)
  active           Boolean      @default(true)
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  redemptions DiscountRedemption[]
}

model DiscountRedemption {
  id          String       @id @default(cuid())
  codeId      String
  code        DiscountCode @relation(fields: [codeId], references: [id])
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id])
  userId      String
  amountMinor Int
  createdAt   DateTime     @default(now())

  @@index([codeId, userId])
}

/// Every payment event we act on (webhook, callback check, reconciliation), stored once.
/// The unique key makes processing idempotent: a replayed event is rejected by the database.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  /// webhook | callback | reconcile | admin
  source      String   @default("webhook")
  providerRef String?
  /// What we did with it, e.g. paid, duplicate_payment, amount_mismatch, ignored_out_of_order.
  result      String?
  payload     Json?
  receivedAt  DateTime @default(now())

  @@unique([provider, eventId])
  @@index([providerRef])
  @@index([receivedAt, result])
}

model Commission {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  type          CommissionType
  status        CommissionStatus @default(PENDING)
  amountMinor   Int
  /// Taken back after refunds or chargebacks. The amount itself is never edited; effective = amount − reversed.
  reversedMinor Int              @default(0)
  ledger        LedgerEntry[]
  /// How much of this commission has been covered by completed payouts.
  paidMinor     Int              @default(0)
  releaseAt     DateTime?
  approvedAt    DateTime?
  holdReason    String?
  orderId       String?
  order         Order?           @relation(fields: [orderId], references: [id])
  runId         String?
  run           BinaryRun?       @relation(fields: [runId], references: [id])
  /// Rule version, qualifying sale amount and rate used, so the figure can be reproduced exactly.
  planVersionId String?
  planVersion   CompPlanVersion? @relation(fields: [planVersionId], references: [id])
  baseMinor     Int?
  rateBps       Int?
  /// Calculation inputs: pairs paid, PV consumed, cap applied, adjustments etc.
  details       Json?
  note          String?
  createdAt     DateTime         @default(now())

  @@unique([userId, type, orderId])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

/// One binary pairing run per period (e.g. per day). periodKey is unique so a run can never pay twice.
model BinaryRun {
  id           String   @id @default(cuid())
  periodKey    String   @unique
  pairsPaid    Int      @default(0)
  amountMinor  Int      @default(0)
  flushedMinor Int      @default(0)
  createdAt    DateTime @default(now())
  actorId      String?

  commissions    Commission[]
  carryMovements CarryMovement[]
}

model Payout {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  amountMinor        Int
  status             PayoutStatus   @default(REQUESTED)
  method             String
  destination        String
  /// Bank or provider transfer reference. Unique, so the same transfer can't be recorded against two payouts.
  reference          String?        @unique
  /// From the request form, so a double-submitted request makes one payout.
  requestKey         String?        @unique
  reviewedById       String?
  reviewedAt         DateTime?
  processedById      String?
  processedAt        DateTime?
  failureReason      String?
  note               String?
  /// The bank account it goes to (snapshot at request time; `destination` holds the masked label).
  payoutAccountId    String?
  payoutAccount      PayoutAccount? @relation(fields: [payoutAccountId], references: [id])
  /// Increases each time a failed payout is queued again (funds are reserved again for each attempt).
  attempt            Int            @default(1)
  batchId            String?
  batch              PayoutBatch?   @relation(fields: [batchId], references: [id])
  /// Proof the money arrived: "provider" (gateway transfer result) or "bank" (bank statement / transfer receipt).
  settlementSource   String?
  settlementEvidence String?
  settledAt          DateTime?
  createdAt          DateTime       @default(now())

  ledger LedgerEntry[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([batchId])
  @@index([settledAt])
}

/// A member's bank account for withdrawals. Only what is needed to pay is kept: bank, account number
/// (encrypted), and the account name returned by verification. Staff see the number masked unless they
/// hold the PAYOUT_DETAILS permission.
model PayoutAccount {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  bankCode         String
  bankName         String
  accountNumberEnc String
  accountLast4     String
  /// Keyed hash of bank + number, to spot one account used by several members without decrypting.
  fingerprint      String
  accountName      String
  /// "paystack", "test", or null when it couldn't be checked automatically (staff check it at review).
  verifiedBy       String?
  verifiedAt       DateTime?
  /// Withdrawals to a newly added account are allowed only after this time (protects against account takeover).
  usableFrom       DateTime
  status           PayoutAccountStatus @default(ACTIVE)
  createdAt        DateTime            @default(now())
  removedAt        DateTime?

  payouts Payout[]

  @@index([userId, status])
  @@index([fingerprint])
}

/// A group of approved payouts sent together (e.g. one bank bulk-transfer file).
model PayoutBatch {
  id           String            @id @default(cuid())
  number       String            @unique
  status       PayoutBatchStatus @default(OPEN)
  totalMinor   Int
  count        Int
  createdById  String
  exportedById String?
  exportedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime          @default(now())

  payouts Payout[]
}

/// Append-only money ledger. Rows are never updated or deleted (database trigger); mistakes are fixed with new,
/// compensating entries. Every row moves a positive amount from one bucket to another for one member.
model LedgerEntry {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  type           LedgerType
  amountMinor    Int
  /// Null means money entering from outside (a sale) or leaving (a correction debit).
  fromBucket     LedgerBucket?
  toBucket       LedgerBucket?
  /// What caused it, e.g. ("Commission", id), ("Payout", id), ("Correction", auditId).
  sourceType     String
  sourceId       String
  commissionId   String?
  commission     Commission?   @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  payoutId       String?
  payout         Payout?       @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  /// Unique per business event, so retries and duplicate events can never post twice.
  idempotencyKey String        @unique
  memo           String?
  actorId        String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([commissionId])
  @@index([sourceType, sourceId])
  @@index([payoutId])
  @@index([type, createdAt])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Tamper-evident: each row stores a hash of its content and of the previous row, and rows can't be
/// updated or deleted (database trigger). verifyAuditChain() re-computes the chain.
model AuditLog {
  id        String   @id @default(cuid())
  seq       Int      @unique @default(autoincrement())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  /// Position in the hash chain, assigned when the row is sealed (see src/lib/audit.ts).
  chainPos  Int?     @unique
  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String
  postal    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  reason       String
  status       ReturnStatus @default(REQUESTED)
  adminNote    String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
  @@index([orderId])
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  subject   String
  orderId   String?
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  isStaff   Boolean
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

/// Only shown when the customer gave consent and an admin published it. Never seeded with made-up quotes.
model Testimonial {
  id               String   @id @default(cuid())
  name             String
  location         String?
  quote            String
  consentConfirmed Boolean  @default(false)
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  body      String
  ip        String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Every email the app sends. In development nothing leaves the server; admins can read them here.
model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  body      String
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([sentAt, createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum PlacementMethod {
  AUTO
  SPONSOR_CHOICE
  ADMIN
}

/// Immutable record of how and by whom each member was placed. Never updated or deleted.
model PlacementRecord {
  id        String          @id @default(cuid())
  nodeId    String          @unique
  node      AffiliateNode   @relation(fields: [nodeId], references: [id])
  userId    String
  sponsorId String?
  parentId  String?
  position  Leg?
  method    PlacementMethod
  actorId   String?
  note      String?
  createdAt DateTime        @default(now())
}

/// Every saved compensation plan becomes a new, immutable version. Orders record the version in force when
/// they were paid, and commissions record the version they were calculated with.
model CompPlanVersion {
  id          String   @id @default(cuid())
  version     Int      @unique
  rules       Json
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  orders      Order[]
  commissions Commission[]
}

/// A stockist: a shop or centre where members can buy or collect products. Managed by staff in admin.
model Stockist {
  id        String   @id @default(cuid())
  name      String
  state     String
  city      String
  address   String
  phone     String?
  hours     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, state])
}
