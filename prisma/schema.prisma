generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  AFFILIATE
  ADMIN
  SUPER_ADMIN
}

/// Areas an ADMIN can be granted. SUPER_ADMIN has all of them.
enum AdminPermission {
  ORDERS
  PRODUCTS
  MEMBERS
  NETWORK
  COMMISSIONS
  PAYOUTS
  SUPPORT
  RISK
  SETTINGS
  AUDIT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Leg {
  LEFT
  RIGHT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InventoryReason {
  RESTOCK
  SALE
  RELEASE
  REFUND
  ADJUSTMENT
}

enum CommissionType {
  DIRECT
  BINARY
  ADJUSTMENT
}

enum CommissionStatus {
  /// Earned on a paid order, waiting for the refund window to close.
  PENDING
  /// Frozen by a dispute or by an administrator.
  HELD
  /// Counts toward the withdrawable balance.
  APPROVED
  REVERSED
  /// Fully covered by a completed payout.
  PAID
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

model User {
  id            String     @id @default(cuid())
  /// Always stored lower-cased and trimmed (enforced by a CHECK constraint).
  email         String     @unique
  emailVerifiedAt DateTime?
  passwordHash  String
  emailOrderUpdates      Boolean @default(true)
  emailCommissionUpdates Boolean @default(true)
  emailMarketing         Boolean @default(false)
  name          String
  phone         String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  referralCode  String     @unique
  signupIp      String?
  adminPermissions AdminPermission[]
  /// TOTP secret, encrypted with APP_ENCRYPTION_KEY.
  mfaSecretEnc  String?
  mfaEnabledAt  DateTime?
  /// Last accepted TOTP time step, to stop a code being reused.
  mfaLastStep   Int?
  mfaRecoveryHashes String[]
  sponsorId     String?
  sponsor       User?      @relation("Sponsorship", fields: [sponsorId], references: [id])
  referrals     User[]     @relation("Sponsorship")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions    Session[]
  node        AffiliateNode?
  cartItems   CartItem[]
  orders      Order[]
  commissions Commission[]
  payouts     Payout[]
  addresses   Address[]
  notifications Notification[]
  tickets     SupportTicket[]
  returns     ReturnRequest[]

  @@index([sponsorId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// True until the second factor is entered for an MFA-enabled account.
  mfaPending    Boolean   @default(false)
  lastSeenAt    DateTime  @default(now())
  mfaVerifiedAt DateTime?
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// A position in the binary tree. One per affiliate.
model AffiliateNode {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id])
  parentId    String?
  parent      AffiliateNode?  @relation("Tree", fields: [parentId], references: [id])
  children    AffiliateNode[] @relation("Tree")
  position    Leg?
  depth       Int             @default(0)
  /// Ancestor node ids, root first. Used to credit volume up the tree in one query.
  ancestorIds String[]
  /// Preferred leg for new referrals when the link doesn't specify one. Null = weaker leg.
  defaultLeg  Leg?

  personalPv  Int @default(0)
  leftCarryPv Int @default(0)
  rightCarryPv Int @default(0)
  leftTotalPv Int @default(0)
  rightTotalPv Int @default(0)
  leftCount   Int @default(0)
  rightCount  Int @default(0)

  createdAt DateTime @default(now())

  volumes VolumeEntry[]

  @@unique([parentId, position])
  @@index([parentId])
}

/// Every PV credit to a node's leg, so volume can be audited and reversed.
model VolumeEntry {
  id        String        @id @default(cuid())
  nodeId    String
  node      AffiliateNode @relation(fields: [nodeId], references: [id])
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  leg       Leg?
  /// Positive on credit, negative on reversal. Null leg = personal volume.
  pv        Int
  createdAt DateTime      @default(now())

  @@index([nodeId])
  @@index([orderId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
}

model Product {
  id                String   @id @default(cuid())
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  /// Extra gallery images; imageUrl is the main one.
  images            String[]
  sku               String   @unique
  slug              String   @unique
  name              String
  description       String
  priceMinor        Int
  pv                Int      @default(0)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  weightGrams       Int      @default(0)
  imageUrl          String?
  active            Boolean  @default(true)
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]
}

model InventoryMovement {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  delta     Int
  reason    InventoryReason
  orderId   String?
  actorId   String?
  note      String?
  createdAt DateTime        @default(now())

  @@index([productId, createdAt])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id            String      @id @default(cuid())
  number        String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING_PAYMENT)
  currency      String
  subtotalMinor Int
  shippingMinor Int
  totalMinor    Int
  totalPv       Int
  /// Node that receives this order's volume (buyer's node, or their sponsor's node for customers).
  volumeNodeId  String?
  /// Sponsor credited with the direct bonus, snapshotted at checkout.
  referrerId    String?

  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipCountry String
  shipPostal  String?
  carrier     String?
  trackingRef String?
  shippedAt   DateTime?
  deliveredAt DateTime?

  paidAt          DateTime?
  /// Set while a chargeback is open; such orders don't earn commissions until it's resolved.
  disputedAt      DateTime?
  /// Set when the refund-hold window passes and commissions + volume are credited.
  commissionedAt  DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items       OrderItem[]
  payments    Payment[]
  volumes     VolumeEntry[]
  commissions Commission[]
  returns     ReturnRequest[]

  @@index([userId])
  @@index([referrerId])
  @@index([status, paidAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  name           String
  sku            String
  unitPriceMinor Int
  pv             Int
  quantity       Int
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  provider    String
  providerRef String        @unique
  status      PaymentStatus @default(PENDING)
  amountMinor Int
  currency    String
  raw         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
}

/// Idempotency for payment webhooks.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  type       String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model Commission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        CommissionType
  status      CommissionStatus @default(PENDING)
  amountMinor Int
  /// How much of this commission has been covered by completed payouts.
  paidMinor   Int              @default(0)
  releaseAt   DateTime?
  approvedAt  DateTime?
  holdReason  String?
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id])
  runId       String?
  run         BinaryRun?       @relation(fields: [runId], references: [id])
  /// Pairs paid, PV consumed, cap applied etc.
  details     Json?
  note        String?
  createdAt   DateTime         @default(now())

  @@unique([userId, type, orderId])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([status])
}

/// One binary pairing run per period (e.g. per day). periodKey is unique so a run can never pay twice.
model BinaryRun {
  id          String   @id @default(cuid())
  periodKey   String   @unique
  pairsPaid   Int      @default(0)
  amountMinor Int      @default(0)
  flushedMinor Int     @default(0)
  createdAt   DateTime @default(now())
  actorId     String?

  commissions Commission[]
}

model Payout {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  amountMinor  Int
  status       PayoutStatus @default(REQUESTED)
  method       String
  destination  String
  reference    String?
  processedById String?
  processedAt  DateTime?
  note         String?
  createdAt    DateTime     @default(now())

  @@index([userId, status])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String
  postal    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  reason       String
  status       ReturnStatus @default(REQUESTED)
  adminNote    String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
  @@index([orderId])
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  subject   String
  orderId   String?
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  isStaff   Boolean
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

/// Only shown when the customer gave consent and an admin published it. Never seeded with made-up quotes.
model Testimonial {
  id               String   @id @default(cuid())
  name             String
  location         String?
  quote            String
  consentConfirmed Boolean  @default(false)
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  body      String
  ip        String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Every email the app sends. In development nothing leaves the server; admins can read them here.
model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  body      String
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
